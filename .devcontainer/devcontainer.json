{
  "name": "jg-lead",
  "dockerComposeFile": "compose.yml",
  "service": "jg-lead",
  "workspaceFolder": "/app",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/rails/devcontainer/features/activestorage":  {},
    "ghcr.io/rails/devcontainer/features/postgres-client":  {},
    "node": {
      "version": "lts",
      "nodeGypDependencies": true
    }
  },
  "containerEnv": {
    "DB_HOST": "postgres"
  },
  "forwardPorts": [3000, 5432],

  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "bradlc.vscode-tailwindcss",
        "marcoroth.herb-lsp"
      ]
    }
  },

  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.local/share/opencode && curl -fsSL https://opencode.ai/install | bash"
}
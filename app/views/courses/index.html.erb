<% content_for :page_title, "Courses" %>

<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-semibold">Courses</h1>
  <% if policy(Course).create? %>
    <%= link_to "New course", new_course_path, class: "btn btn-primary btn-sm" %>
  <% end %>
</div>

<div role="tablist" class="tabs tabs-box mb-4">
  <% [["upcoming", "Upcoming"], ["past", "Past"], ["all", "All"]].each do |tab, label| %>
    <%= link_to label, courses_path(tab: tab), role: "tab",
          class: "tab #{'tab-active' if @tab == tab}" %>
  <% end %>
</div>

<% if @courses.any? %>
  <% show_attendees = @show_attendance_summary %>
  <div class="card bg-base-100 shadow">
    <table class="table">
      <thead>
        <tr>
          <th>Course</th><th>Organization</th><th>Date</th><th>Location</th>
          <% if show_attendees %><th>Attendees</th><% end %>
        </tr>
      </thead>
      <tbody>
        <% @courses.each do |course| %>
          <tr>
            <td><%= link_to course.name, course_path(course), class: "link link-hover font-medium" %></td>
            <td><%= course.organization.name %></td>
            <td class="whitespace-nowrap"><%= format_datetime(course.starts_at) %></td>
            <td><%= course.location %></td>
            <% if show_attendees %>
              <td>
                <span class="badge badge-ghost"><%= course.course_attendances.size %></span>
                <% attended = course.course_attendances.count(&:attended?) %>
                <% if attended.positive? %>
                  <span class="badge badge-success badge-outline badge-sm ml-1"><%= attended %> attended</span>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="alert alert-info"><span>No courses in this view yet.</span></div>
<% end %>

<nav aria-label="breadcrumbs" class="breadcrumbs mb-2">
  <ul><li><%= link_to "Courses", courses_path %></li><li><%= @course.name %></li></ul>
</nav>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="card bg-base-100 shadow lg:col-span-2">
    <div class="card-body">
      <div class="flex items-start justify-between gap-2">
        <div>
          <h1 class="card-title"><%= @course.name %></h1>
          <p class="text-sm opacity-60"><%= @course.organization.name %><% if @course.location.present? %> · <%= @course.location %><% end %></p>
        </div>
        <span class="badge <%= @course.past? ? "badge-ghost" : "badge-info" %>"><%= @course.past? ? "Past" : "Upcoming" %></span>
      </div>

      <% if @course.description.present? %>
        <p class="mt-2 opacity-80"><%= simple_format(@course.description) %></p>
      <% end %>

      <dl class="grid grid-cols-2 gap-2 text-sm mt-4 max-w-md">
        <dt class="opacity-60">Starts</dt><dd><%= format_datetime(@course.starts_at) %></dd>
        <dt class="opacity-60">Ends</dt><dd><%= format_datetime(@course.ends_at) %></dd>
      </dl>

      <% if policy(@course).update? || policy(@course).destroy? %>
        <div class="card-actions justify-end mt-4">
          <% if policy(@course).update? %>
            <%= link_to "Edit", edit_course_path(@course), class: "btn btn-outline btn-sm" %>
          <% end %>
          <% if policy(@course).destroy? %>
            <%= button_to "Delete", course_path(@course), method: :delete, form: { class: "inline" }, data: { turbo_confirm: "Delete this course?" }, class: "btn btn-error btn-outline btn-sm" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card bg-base-100 shadow h-fit">
    <div class="card-body">
      <h2 class="card-title">Counts Toward</h2>
      <% if @course_requirements.any? %>
        <table class="table table-sm">
          <thead><tr><th>Requirement</th><th class="text-right">Hours</th></tr></thead>
          <tbody>
            <% @course_requirements.each do |course_requirement| %>
              <tr>
                <td>
                  <% if policy(JuleicaRequirement).show? %>
                    <%= link_to course_requirement.juleica_requirement.name, juleica_requirement_path(course_requirement.juleica_requirement), class: "link link-hover" %>
                  <% else %>
                    <%= course_requirement.juleica_requirement.name %>
                  <% end %>
                </td>
                <td class="text-right"><span class="badge badge-primary badge-outline">+ <%= format_hours(course_requirement.hours) %> h</span></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="opacity-60">This course does not count toward any requirement yet.</p>
      <% end %>
    </div>
  </div>
</div>

<% if policy(@course).view_attendees? %>
  <div class="card bg-base-100 shadow mt-6">
    <div class="card-body">
      <h2 class="card-title">Attendees</h2>

      <% if @attendee_management %>
        <% if @registrable_users.any? %>
          <%= form_with model: [@course, CourseAttendance.new], url: course_course_attendances_path(@course), method: :post, class: "flex flex-wrap items-end gap-2 mb-4" do |f| %>
            <fieldset class="fieldset w-full sm:w-72">
              <legend class="fieldset-legend">Register attendee</legend>
              <%= f.select :user_id, options_from_collection_for_select(@registrable_users, :id, :email), { prompt: "Select user" }, class: "select w-full", required: true %>
            </fieldset>
            <%= f.submit "Register", class: "btn btn-primary" %>
          <% end %>
        <% else %>
          <p class="text-sm opacity-60 mb-4">All users are already registered for this course.</p>
        <% end %>
      <% end %>

      <% if @attendances.any? %>
        <table class="table table-sm">
          <thead>
            <tr>
              <th>User</th><th>Status</th>
              <% if @attendee_management %><th class="text-right">Actions</th><% end %>
            </tr>
          </thead>
          <tbody>
            <% @attendances.each do |attendance| %>
              <tr>
                <td><%= link_to attendance.user.email, user_path(attendance.user), class: "link link-hover" %></td>
                <td><span class="badge <%= attendance_status_badge_class(attendance.status) %>"><%= attendance.status.humanize %></span></td>
                <% if policy(attendance).update? %>
                  <td class="text-right space-x-1 whitespace-nowrap">
                    <% (CourseAttendance.statuses.keys - [attendance.status]).each do |status| %>
                      <%= button_to status.humanize,
                            course_course_attendance_path(@course, attendance),
                            method: :patch,
                            params: { course_attendance: { status: status } },
                            form: { class: "inline" },
                            class: "btn btn-xs #{'btn-success' if status == 'attended'} #{'btn-outline' unless status == 'attended'}" %>
                    <% end %>
                    <%= button_to "Remove",
                          course_course_attendance_path(@course, attendance),
                          method: :delete,
                          form: { class: "inline" },
                          data: { turbo_confirm: "Remove attendance record?" },
                          class: "btn btn-error btn-outline btn-xs" %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="opacity-60">No attendees registered yet.</p>
      <% end %>
    </div>
  </div>
<% end %>

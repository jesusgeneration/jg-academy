<%= form_with model: course, class: "space-y-4" do |f| %>
  <% if course.errors.any? %>
    <div role="alert" class="alert alert-error">
      <span><%= pluralize(course.errors.count, "error") %> prevented saving:</span>
    </div>
  <% end %>

  <fieldset class="fieldset">
    <legend class="fieldset-legend">Name</legend>
    <%= f.text_field :name, class: "input w-full", required: true, autofocus: true %>
  </fieldset>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <fieldset class="fieldset">
      <legend class="fieldset-legend">Organization</legend>
      <%= f.collection_select :organization_id, @permitted_organizations, :id, :name,
            { prompt: "Select organization" }, { class: "select w-full", required: true } %>
    </fieldset>

    <fieldset class="fieldset">
      <legend class="fieldset-legend">Location</legend>
      <%= f.text_field :location, class: "input w-full" %>
    </fieldset>

    <fieldset class="fieldset">
      <legend class="fieldset-legend">Starts at</legend>
      <%= f.datetime_field :starts_at, class: "input w-full", required: true %>
    </fieldset>

    <fieldset class="fieldset">
      <legend class="fieldset-legend">Ends at</legend>
      <%= f.datetime_field :ends_at, class: "input w-full", required: true %>
    </fieldset>
  </div>

  <fieldset class="fieldset">
    <legend class="fieldset-legend">Description</legend>
    <%= f.text_area :description, rows: 3, class: "textarea w-full" %>
  </fieldset>

  <div class="border border-base-300 rounded-box p-4">
    <h2 class="font-semibold mb-2">Content coverage</h2>
    <p class="text-xs opacity-60 mb-3">Coverage is managed separately via course coverages.</p>
    <% if course.persisted? && course.covered_contents.any? %>
      <ul class="text-sm space-y-1">
        <% course.covered_contents.includes(:parent).ordered.each do |content| %>
          <li><span class="badge badge-ghost badge-sm mr-1"><%= content.content_type %></span><%= content.title %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-xs opacity-60">No content covered yet.</p>
    <% end %>
  </div>

  <div class="flex gap-2">
    <%= f.submit course.new_record? ? "Create course" : "Update course", class: "btn btn-primary" %>
    <%= link_to "Cancel", courses_path, class: "btn btn-ghost" %>
  </div>
<% end %>

<%= form_with model: unit, class: "space-y-4" do |f| %>
  <% if unit.errors.any? %>
    <div role="alert" class="alert alert-error">
      <span><%= t(".errors_prevented", count: unit.errors.count) %></span>
    </div>
  <% end %>

  <fieldset class="fieldset min-w-0">
    <legend class="fieldset-legend"><%= t(".name") %></legend>
    <%= f.text_field :name, class: "input w-full", required: true, autofocus: true %>
  </fieldset>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <fieldset class="fieldset min-w-0">
      <legend class="fieldset-legend"><%= t(".program") %></legend>
      <%= f.collection_select :program_id, @permitted_programs, :id, :name,
            { prompt: t(".select_program") }, { class: "select w-full", required: true } %>
    </fieldset>

    <fieldset class="fieldset min-w-0">
      <legend class="fieldset-legend"><%= t(".location") %></legend>
      <%= f.text_field :location, class: "input w-full" %>
    </fieldset>

    <fieldset class="fieldset min-w-0 sm:col-span-2">
      <legend class="fieldset-legend"><%= t(".starts_at") %></legend>
      <% start_parts = unit_datetime_parts(unit) %>
      <div class="grid grid-cols-[1fr_auto] gap-2">
        <div class="min-w-0">
          <%= f.date_field :start_date, value: start_parts[0], class: "input w-full" %>
          <p class="label"><%= t(".date") %></p>
        </div>
        <div>
          <%= f.select :start_time, unit_time_options(start_parts[1]), { prompt: t(".select_time") }, class: "select w-auto max-w-40" %>
          <p class="label"><%= t(".time") %></p>
        </div>
      </div>
      <p class="label"><%= t(".starts_at_hint") %></p>
    </fieldset>

    <fieldset class="fieldset min-w-0">
      <legend class="fieldset-legend"><%= t(".duration") %></legend>
      <%= f.select :duration_minutes, unit_duration_options(unit_duration_value(unit)), { prompt: t(".select_duration") }, class: "select w-full" %>
    </fieldset>

    <fieldset class="fieldset min-w-0">
      <legend class="fieldset-legend"><%= t(".instructor") %></legend>
      <%= f.collection_select :instructor_id, @eligible_instructors, :id, :email,
            { prompt: t(".select_instructor") }, { class: "select w-full" } %>
      <p class="label"><%= t(".instructor_hint") %></p>
    </fieldset>
  </div>

  <fieldset class="fieldset min-w-0">
    <legend class="fieldset-legend"><%= t(".description") %></legend>
    <%= f.text_area :description, rows: 3, class: "textarea w-full" %>
  </fieldset>

  <% if unit.new_record? %>
    <%= render "coverage_fields", coverage_tree: @coverage_tree %>
  <% else %>
  <div class="border border-base-300 rounded-box p-4">
    <h2 class="font-semibold mb-2"><%= t(".coverage_title") %></h2>
    <p class="text-xs opacity-60 mb-3"><%= t(".coverage_hint") %></p>
    <% if unit.covered_contents.any? %>
      <ul class="text-sm space-y-1">
        <% unit.covered_contents.includes(:parent).ordered.each do |content| %>
          <li><span class="badge badge-ghost badge-sm mr-1"><%= human_enum_label("content", "content_type", content.content_type) %></span><%= content.title %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-xs opacity-60"><%= t(".no_coverage") %></p>
    <% end %>
  </div>
  <% end %>

  <div class="flex gap-2">
    <%= f.submit unit.new_record? ? t(".create") : t(".update"), class: "btn btn-primary" %>
    <%= link_to t(".cancel"), units_path, class: "btn btn-ghost" %>
  </div>
<% end %>

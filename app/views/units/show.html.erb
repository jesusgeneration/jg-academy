<nav aria-label="breadcrumbs" class="breadcrumbs mb-2">
  <ul>
    <li><%= link_to t(".breadcrumb_programs"), programs_path %></li>
    <li><%= link_to @unit.program.name, program_path(@unit.program) %></li>
    <li><%= @unit.name %></li>
  </ul>
</nav>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="card bg-base-100 shadow lg:col-span-2">
    <div class="card-body">
      <div class="flex items-start justify-between gap-2">
        <div>
          <h1 class="card-title"><%= @unit.name %></h1>
          <p class="text-sm opacity-60"><%= @unit.program.organization.name %> · <%= link_to @unit.program.name, program_path(@unit.program), class: "link link-hover" %><% if @unit.location.present? %> · <%= @unit.location %><% end %></p>
        </div>
        <span class="badge <%= @unit.past? ? "badge-ghost" : "badge-info" %>"><%= @unit.past? ? t(".status.past") : t(".status.upcoming") %></span>
      </div>

      <% if @unit.description.present? %>
        <p class="mt-2 opacity-80"><%= simple_format(@unit.description) %></p>
      <% end %>

      <dl class="grid grid-cols-2 gap-2 text-sm mt-4 max-w-md">
        <dt class="opacity-60"><%= t(".starts") %></dt><dd><%= format_datetime(@unit.starts_at) %></dd>
        <dt class="opacity-60"><%= t(".ends") %></dt><dd><%= format_datetime(@unit.ends_at) %></dd>
      </dl>

      <% if policy(@unit).update? || policy(@unit).destroy? %>
        <div class="card-actions justify-end mt-4">
          <% if policy(@unit).update? %>
            <%= link_to t(".edit"), edit_unit_path(@unit), class: "btn btn-outline btn-sm" %>
          <% end %>
          <% if policy(@unit).destroy? %>
            <%= button_to t(".delete"), unit_path(@unit), method: :delete, form: { class: "inline" }, data: { turbo_confirm: t(".confirm_delete") }, class: "btn btn-error btn-outline btn-sm" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card bg-base-100 shadow h-fit">
    <div class="card-body">
      <h2 class="card-title"><%= t(".covers") %></h2>
      <p class="text-xs opacity-60"><%= t(".covers_hint") %></p>
      <% covered = @unit.covered_contents.order(:position) %>
      <% if covered.any? %>
        <ul class="space-y-1 text-sm mt-2">
          <% covered.each do |content| %>
            <li>
              <span class="badge badge-ghost badge-sm mr-1"><%= human_enum_label("content", "content_type", content.content_type) %></span>
              <%= content.title %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="opacity-60"><%= t(".no_coverage") %></p>
      <% end %>
    </div>
  </div>
</div>

<% if policy(@unit).update? %>
  <div class="card bg-base-100 shadow mt-6">
    <div class="card-body">
      <h2 class="card-title"><%= t(".manage_coverage") %></h2>
      <p class="text-sm opacity-60"><%= t(".manage_coverage_hint") %></p>
      <% if @coverage_tree.any? %>
        <div class="space-y-2 mt-2">
          <% @coverage_tree.each do |level| %>
            <% subtree_ids = [ level.id ] + level.children.flat_map { |s| [ s.id ] + s.children.map(&:id) } %>
            <% level_open = (@coverages_by_content_id.keys & subtree_ids).any? %>
            <div class="flex items-start gap-2">
              <div class="collapse collapse-arrow bg-base-200 flex-1">
                <input type="checkbox" <%= "checked" if level_open %> />
                <div class="collapse-title text-sm font-medium py-2 min-h-0">
                  <span class="badge badge-primary badge-outline badge-sm mr-1"><%= human_enum_label("content", "content_type", level.content_type) %></span>
                  <%= level.title %>
                </div>
                <div class="collapse-content">
                  <% if level.children.any? %>
                    <div class="space-y-2">
                      <% level.children.each do |section| %>
                        <% section_ids = [ section.id ] + section.children.map(&:id) %>
                        <% section_open = (@coverages_by_content_id.keys & section_ids).any? %>
                        <% section_via_ancestor = @coverages_by_content_id.key?(level.id) %>
                        <div class="flex items-start gap-2">
                          <div class="collapse collapse-arrow bg-base-100 flex-1">
                            <input type="checkbox" <%= "checked" if section_open %> />
                            <div class="collapse-title text-sm py-2 min-h-0">
                              <span class="badge badge-secondary badge-outline badge-sm mr-1"><%= human_enum_label("content", "content_type", section.content_type) %></span>
                              <%= section.title %>
                              <% if section_via_ancestor %>
                                <span class="text-xs opacity-50 ml-1"><%= t(".covered_via", title: level.title) %></span>
                              <% end %>
                            </div>
                            <div class="collapse-content">
                              <% if section.children.any? %>
                                <ul class="space-y-1">
                                  <% section.children.each do |detail| %>
                                    <% via = if @coverages_by_content_id.key?(section.id)
                                               section.title
                                             elsif section_via_ancestor
                                               level.title
                                             end %>
                                    <li class="flex items-center justify-between gap-2">
                                      <span>
                                        <span class="badge badge-ghost badge-sm mr-1"><%= human_enum_label("content", "content_type", detail.content_type) %></span>
                                        <%= detail.title %>
                                        <% if via %>
                                          <span class="text-xs opacity-50 ml-1"><%= t(".covered_via", title: via) %></span>
                                        <% end %>
                                      </span>
                                      <%= coverage_row_button(@unit, detail, @coverages_by_content_id, ancestor_covered: via.present?) %>
                                    </li>
                                  <% end %>
                                </ul>
                              <% end %>
                            </div>
                          </div>
                          <div class="pt-2">
                            <%= coverage_row_button(@unit, section, @coverages_by_content_id, ancestor_covered: section_via_ancestor) %>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
              <div class="pt-2">
                <%= coverage_toggle_button(@unit, level, @coverages_by_content_id) %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="opacity-60"><%= t(".no_content") %></p>
      <% end %>
    </div>
  </div>
<% end %>

<% if policy(@unit).view_attendees? %>
  <div class="card bg-base-100 shadow mt-6">
    <div class="card-body">
      <h2 class="card-title"><%= t(".attendees") %></h2>

      <% if @attendee_management %>
        <% if @registrable_users.any? %>
          <%= form_with model: [@unit, UnitAttendance.new], url: unit_unit_attendances_path(@unit), method: :post, class: "flex flex-wrap items-end gap-2 mb-4" do |f| %>
            <fieldset class="fieldset w-full sm:w-72">
              <legend class="fieldset-legend"><%= t(".register_attendee") %></legend>
              <%= f.select :user_id, options_from_collection_for_select(@registrable_users, :id, :email), { prompt: t(".select_user") }, class: "select w-full", required: true %>
            </fieldset>
            <%= f.submit t(".register"), class: "btn btn-primary" %>
          <% end %>
        <% else %>
          <p class="text-sm opacity-60 mb-4"><%= t(".all_registered") %></p>
        <% end %>
      <% end %>

      <% if @attendances.any? %>
        <table class="table table-sm">
          <thead>
            <tr>
              <th><%= t(".table.user") %></th><th><%= t(".table.status") %></th>
              <% if @attendee_management %><th class="text-right"><%= t(".table.actions") %></th><% end %>
            </tr>
          </thead>
          <tbody>
            <% @attendances.each do |attendance| %>
              <tr>
                <td><%= link_to attendance.user.email, user_path(attendance.user), class: "link link-hover" %></td>
                <td><span class="badge <%= attendance_status_badge_class(attendance.status) %>"><%= human_enum_label("unit_attendance", "status", attendance.status) %></span></td>
                <% if policy(attendance).update? %>
                  <td class="text-right space-x-1 whitespace-nowrap">
                    <% (UnitAttendance.statuses.keys - [attendance.status]).each do |status| %>
                      <%= button_to human_enum_label("unit_attendance", "status", status),
                            unit_unit_attendance_path(@unit, attendance),
                            method: :patch,
                            params: { unit_attendance: { status: status } },
                            form: { class: "inline" },
                            class: "btn btn-xs #{'btn-success' if status == 'attended'} #{'btn-outline' unless status == 'attended'}" %>
                    <% end %>
                    <%= button_to t(".remove"),
                          unit_unit_attendance_path(@unit, attendance),
                          method: :delete,
                          form: { class: "inline" },
                          data: { turbo_confirm: t(".confirm_remove_attendance") },
                          class: "btn btn-error btn-outline btn-xs" %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="opacity-60"><%= t(".no_attendees") %></p>
      <% end %>
    </div>
  </div>
<% end %>

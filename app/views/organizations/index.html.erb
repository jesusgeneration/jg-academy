<% content_for :page_title, "Veranstalter" %>

<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-semibold">Veranstalter</h1>
  <%= link_to "Neuer Veranstalter", new_organization_path, class: "btn btn-primary btn-sm" %>
</div>

<% if @organizations.any? %>
  <div class="card bg-base-100 shadow">
    <table class="table">
      <thead>
        <tr><th>Name</th><th>Mitglieder</th><th>Kurse</th><th class="text-right">Aktionen</th></tr>
      </thead>
      <tbody>
        <% @organizations.each do |organization| %>
          <tr>
            <td><%= link_to organization.name, organization_path(organization), class: "link link-hover font-medium" %></td>
            <td><span class="badge badge-ghost"><%= organization.users.size %></span></td>
            <td><span class="badge badge-ghost"><%= organization.courses.size %></span></td>
            <td class="text-right space-x-2 whitespace-nowrap">
              <%= link_to "Bearbeiten", edit_organization_path(organization), class: "btn btn-ghost btn-xs" %>
              <%= button_to "Löschen", organization_path(organization), method: :delete, form: { class: "inline" }, data: { turbo_confirm: "„#{organization.name}“ löschen?" }, class: "btn btn-error btn-outline btn-xs" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="alert alert-info"><span>Noch keine Veranstalter. Erstelle den ersten.</span></div>
<% end %>

<% content_for :page_title, t(".page_title") %>

<nav aria-label="breadcrumbs" class="breadcrumbs mb-2">
  <ul><li><%= link_to t(".breadcrumb_root"), organizations_path %></li><li><%= @organization.name %></li></ul>
</nav>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="card bg-base-100 shadow">
    <div class="card-body">
      <h1 class="card-title"><%= @organization.name %></h1>
      <% if @organization.description.present? %>
        <p class="opacity-80"><%= simple_format(@organization.description) %></p>
      <% end %>
    </div>
  </div>

  <div class="card bg-base-100 shadow">
    <div class="card-body">
      <h2 class="card-title"><%= t(".members") %></h2>
      <% if @memberships.any? %>
        <ul class="menu w-full p-0">
          <% @memberships.each do |membership| %>
            <li>
              <%= link_to user_path(membership.user) do %>
                <span class="flex-1"><%= membership.user.email %></span>
                <span class="badge badge-sm capitalize <%= membership_role_badge_class(membership.role) %>"><%= human_enum_label("organization_membership", "role", membership.role) %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="opacity-60"><%= t(".no_members") %></p>
      <% end %>
    </div>
  </div>

  <div class="card bg-base-100 shadow">
    <div class="card-body">
      <h2 class="card-title"><%= t(".programs") %></h2>
      <% if @programs.any? %>
        <table class="table table-sm">
          <thead><tr><th><%= t(".table.program") %></th><th><%= t(".table.kind") %></th></tr></thead>
          <tbody>
            <% @programs.each do |program| %>
              <tr>
                <td><%= link_to program.name, program_path(program), class: "link link-hover" %></td>
                <td><span class="badge badge-ghost badge-sm capitalize"><%= human_enum_label("program", "kind", program.kind) %></span></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="opacity-60"><%= t(".no_programs") %></p>
      <% end %>
    </div>
  </div>
</div>

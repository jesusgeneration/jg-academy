<%= form_with model: organization, class: "space-y-4" do |f| %>
  <% if organization.errors.any? %>
    <div role="alert" class="alert alert-error">
      <span><%= pluralize(organization.errors.count, "error") %> prevented saving:</span>
    </div>
  <% end %>

  <fieldset class="fieldset">
    <legend class="fieldset-legend">Name</legend>
    <%= f.text_field :name, class: "input w-full", required: true, autofocus: true %>
    <% if organization.errors[:name].any? %>
      <p class="label text-error"><%= organization.errors[:name].to_sentence %></p>
    <% end %>
  </fieldset>

  <fieldset class="fieldset">
    <legend class="fieldset-legend">Description</legend>
    <%= f.text_area :description, rows: 3, class: "textarea w-full" %>
  </fieldset>

  <div class="flex gap-2">
    <%= f.submit organization.new_record? ? "Create organization" : "Update organization", class: "btn btn-primary" %>
    <%= link_to "Cancel", organizations_path, class: "btn btn-ghost" %>
  </div>
<% end %>

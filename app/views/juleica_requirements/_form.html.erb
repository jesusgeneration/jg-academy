<%= form_with model: juleica_requirement, class: "space-y-4" do |f| %>
  <% if juleica_requirement.errors.any? %>
    <div role="alert" class="alert alert-error">
      <span><%= pluralize(juleica_requirement.errors.count, "error") %> prevented saving:</span>
    </div>
  <% end %>

  <fieldset class="fieldset">
    <legend class="fieldset-legend">Name</legend>
    <%= f.text_field :name, class: "input w-full", required: true, autofocus: true %>
    <% if juleica_requirement.errors[:name].any? %>
      <p class="label text-error"><%= juleica_requirement.errors[:name].to_sentence %></p>
    <% end %>
  </fieldset>

  <fieldset class="fieldset">
    <legend class="fieldset-legend">Required hours</legend>
    <%= f.number_field :required_hours, step: 0.5, min: 0.5, class: "input w-full", required: true %>
    <% if juleica_requirement.errors[:required_hours].any? %>
      <p class="label text-error"><%= juleica_requirement.errors[:required_hours].to_sentence %></p>
    <% end %>
  </fieldset>

  <fieldset class="fieldset">
    <legend class="fieldset-legend">Description</legend>
    <%= f.text_area :description, rows: 3, class: "textarea w-full" %>
  </fieldset>

  <div class="flex gap-2">
    <%= f.submit juleica_requirement.new_record? ? "Create requirement" : "Update requirement", class: "btn btn-primary" %>
    <%= link_to "Cancel", juleica_requirements_path, class: "btn btn-ghost" %>
  </div>
<% end %>

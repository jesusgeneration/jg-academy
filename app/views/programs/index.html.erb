<% content_for :page_title, t(".page_title") %>

<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-semibold"><%= t(".title") %></h1>
  <% if policy(Program).create? %>
    <%= link_to t(".new"), new_program_path, class: "btn btn-primary btn-sm" %>
  <% end %>
</div>

<div role="tablist" class="tabs tabs-box mb-4">
  <% [["upcoming", t(".tabs.upcoming")], ["past", t(".tabs.past")], ["planned", t(".tabs.planned")], ["all", t(".tabs.all")]].each do |tab, label| %>
    <%= link_to label, programs_path(tab: tab), role: "tab",
          class: "tab #{'tab-active' if @tab == tab}" %>
  <% end %>
</div>

<% if @programs.any? %>
  <div class="card bg-base-100 shadow">
    <table class="table">
      <thead>
        <tr>
          <th><%= sort_link("name", t(".table.program")) %></th><th><%= sort_link("kind", t(".table.kind")) %></th><th><%= sort_link("organization", t(".table.organization")) %></th><th><%= sort_link("units", t(".table.units")) %></th>
        </tr>
      </thead>
      <tbody>
        <% @programs.each do |program| %>
          <tr>
            <td><%= link_to program.name, program_path(program), class: "link link-hover font-medium" %></td>
            <td><span class="badge badge-ghost capitalize"><%= human_enum_label("program", "kind", program.kind) %></span></td>
            <td><%= program.organization.name %></td>
            <td><span class="badge badge-ghost"><%= program.units.size %></span></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="alert alert-info"><span><%= t(".empty") %></span></div>
<% end %>

<nav aria-label="breadcrumbs" class="breadcrumbs mb-2">
  <ul><li><%= link_to t(".breadcrumb_root"), programs_path %></li><li><%= @program.name %></li></ul>
</nav>

<div class="card bg-base-100 shadow">
  <div class="card-body">
    <div class="flex items-start justify-between gap-2">
      <div>
        <h1 class="card-title"><%= @program.name %></h1>
        <p class="text-sm opacity-60">
          <%= @program.organization.name %> ·
          <span class="badge badge-ghost badge-sm capitalize"><%= human_enum_label("program", "kind", @program.kind) %></span>
        </p>
      </div>
      <% if policy(@program).update? || policy(@program).destroy? %>
        <div class="flex gap-2">
          <% if policy(@program).update? %>
            <%= link_to t(".edit"), edit_program_path(@program), class: "btn btn-outline btn-sm" %>
          <% end %>
          <% if policy(@program).destroy? %>
            <%= button_to t(".delete"), program_path(@program), method: :delete, form: { class: "inline" }, data: { turbo_confirm: t(".confirm_delete") }, class: "btn btn-error btn-outline btn-sm" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if @program.description.present? %>
      <p class="mt-2 opacity-80"><%= simple_format(@program.description) %></p>
    <% end %>
  </div>
</div>

<div class="card bg-base-100 shadow mt-6">
  <div class="card-body">
    <h2 class="card-title justify-between">
      <%= t(".units") %>
      <% if policy(Unit).create? %>
        <%= link_to t(".new_unit"), new_unit_path, class: "btn btn-ghost btn-xs" %>
      <% end %>
    </h2>
    <% if @units.any? %>
      <table class="table table-sm">
        <thead>
          <tr><th><%= t(".table.unit") %></th><th><%= t(".table.date") %></th><th><%= t(".table.location") %></th></tr>
        </thead>
        <tbody>
          <% @units.each do |unit| %>
            <tr>
              <td><%= link_to unit.name, unit_path(unit), class: "link link-hover" %></td>
              <td class="whitespace-nowrap"><%= format_datetime(unit.starts_at) %></td>
              <td><%= unit.location %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="opacity-60"><%= t(".no_units") %></p>
    <% end %>
  </div>
</div>

<% if policy(@program).view_attendees? %>
  <div class="card bg-base-100 shadow mt-6">
    <div class="card-body">
      <h2 class="card-title"><%= t(".attendees") %></h2>

      <% if @attendee_management %>
        <% if @registrable_users.any? %>
          <%= form_with model: [@program, ProgramAttendance.new], url: program_program_attendances_path(@program), method: :post, class: "flex flex-wrap items-end gap-2 mb-4" do |f| %>
            <fieldset class="fieldset w-full sm:w-72">
              <legend class="fieldset-legend"><%= t(".register_attendee") %></legend>
              <%= f.select :user_id, options_from_collection_for_select(@registrable_users, :id, :email), { prompt: t(".select_user") }, class: "select w-full", required: true %>
            </fieldset>
            <%= f.submit t(".register"), class: "btn btn-primary" %>
          <% end %>
        <% else %>
          <p class="text-sm opacity-60 mb-4"><%= t(".all_registered") %></p>
        <% end %>
      <% end %>

      <% if @attendances.any? %>
        <table class="table table-sm">
          <thead>
            <tr>
              <th><%= t(".table.user") %></th><th><%= t(".table.status") %></th>
              <% if @attendee_management %><th class="text-right"><%= t(".table.actions") %></th><% end %>
            </tr>
          </thead>
          <tbody>
            <% @attendances.each do |attendance| %>
              <tr>
                <td><%= link_to attendance.user.email, user_path(attendance.user), class: "link link-hover" %></td>
                <td><span class="badge <%= attendance_status_badge_class(attendance.status) %>"><%= human_enum_label("program_attendance", "status", attendance.status) %></span></td>
                <% if policy(attendance).update? %>
                  <td class="text-right space-x-1 whitespace-nowrap">
                    <% (ProgramAttendance.statuses.keys - [attendance.status]).each do |status| %>
                      <%= button_to human_enum_label("program_attendance", "status", status),
                            program_program_attendance_path(@program, attendance),
                            method: :patch,
                            params: { program_attendance: { status: status } },
                            form: { class: "inline" },
                            class: "btn btn-xs #{'btn-success' if status == 'attended'} #{'btn-outline' unless status == 'attended'}" %>
                    <% end %>
                    <%= button_to t(".remove"),
                          program_program_attendance_path(@program, attendance),
                          method: :delete,
                          form: { class: "inline" },
                          data: { turbo_confirm: t(".confirm_remove_attendance") },
                          class: "btn btn-error btn-outline btn-xs" %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="opacity-60"><%= t(".no_attendees") %></p>
      <% end %>
    </div>
  </div>
<% end %>

<% content_for :page_title, t(".page_title") %>

<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-semibold"><%= t(".title") %></h1>
  <%= link_to t(".new"), new_user_path, class: "btn btn-primary btn-sm" %>
</div>

<% if @users.any? %>
  <div class="card bg-base-100 shadow">
    <table class="table">
      <thead>
        <tr><th><%= t(".table.email") %></th><th><%= t(".table.role") %></th><th><%= t(".table.confirmed") %></th><th class="text-right"><%= t(".table.actions") %></th></tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= link_to user.email, user_path(user), class: "link link-hover font-medium" %></td>
            <td><span class="badge capitalize <%= role_badge_class(user.role) %>"><%= human_enum_label("user", "role", user.role) %></span></td>
            <td>
              <% if user.confirmed? %>
                <span class="badge badge-success badge-sm"><%= t(".confirmed_yes") %></span>
              <% else %>
                <span class="badge badge-warning badge-sm"><%= t(".confirmed_pending") %></span>
              <% end %>
            </td>
            <td class="text-right space-x-2 whitespace-nowrap">
              <%= link_to t(".edit"), edit_user_path(user), class: "btn btn-ghost btn-xs" %>
              <% unless user == current_user %>
                <%= button_to t(".delete"), user_path(user), method: :delete, form: { class: "inline" }, data: { turbo_confirm: t(".confirm_delete", email: user.email) }, class: "btn btn-error btn-outline btn-xs" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="alert alert-info"><span><%= t(".empty") %></span></div>
<% end %>

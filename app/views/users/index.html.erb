<% content_for :page_title, "Benutzer" %>

<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-semibold">Benutzer</h1>
  <%= link_to "Neuer Benutzer", new_user_path, class: "btn btn-primary btn-sm" %>
</div>

<% if @users.any? %>
  <div class="card bg-base-100 shadow">
    <table class="table">
      <thead>
        <tr><th>E-Mail</th><th>Rolle</th><th>Bestätigt</th><th class="text-right">Aktionen</th></tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= link_to user.email, user_path(user), class: "link link-hover font-medium" %></td>
            <td><span class="badge capitalize <%= role_badge_class(user.role) %>"><%= display_role(user.role) %></span></td>
            <td>
              <% if user.confirmed? %>
                <span class="badge badge-success badge-sm">ja</span>
              <% else %>
                <span class="badge badge-warning badge-sm">ausstehend</span>
              <% end %>
            </td>
            <td class="text-right space-x-2 whitespace-nowrap">
              <%= link_to "Bearbeiten", edit_user_path(user), class: "btn btn-ghost btn-xs" %>
              <% unless user == current_user %>
                <%= button_to "Löschen", user_path(user), method: :delete, form: { class: "inline" }, data: { turbo_confirm: "„#{user.email}“ löschen?" }, class: "btn btn-error btn-outline btn-xs" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="alert alert-info"><span>Noch keine Benutzer.</span></div>
<% end %>

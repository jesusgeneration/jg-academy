<%= form_with model: user, class: "space-y-4" do |f| %>
  <% if user.errors.any? %>
    <div role="alert" class="alert alert-error">
      <span><%= t(".errors_prevented", count: user.errors.count) %></span>
    </div>
  <% end %>

  <fieldset class="fieldset">
    <legend class="fieldset-legend"><%= t(".email") %></legend>
    <%= f.email_field :email, class: "input w-full", required: true, autofocus: true %>
    <% if user.errors[:email].any? %>
      <p class="label text-error"><%= user.errors[:email].to_sentence %></p>
    <% end %>
  </fieldset>

  <fieldset class="fieldset">
    <legend class="fieldset-legend"><%= t(".role") %></legend>
    <%= f.select :role, User.roles.keys.map { |r| [ human_enum_label("user", "role", r), r ] }, {}, class: "select w-full" %>
  </fieldset>

  <fieldset class="fieldset">
    <legend class="fieldset-legend"><%= t(".language") %></legend>
    <%= f.select :locale, locale_options, {}, class: "select w-full" %>
  </fieldset>

  <fieldset class="fieldset">
    <legend class="fieldset-legend"><%= t(".organizations") %></legend>
    <%= f.fields_for :organization_memberships, @membership_rows do |ff| %>
      <div class="flex items-center justify-between gap-2 py-1">
        <span><%= ff.object.organization.name %></span>
        <%= ff.hidden_field :id %>
        <%= ff.hidden_field :organization_id %>
        <%= ff.select :role,
              options_for_select([[ t(".not_a_member"), "" ], [ human_enum_label("organization_membership", "role", "member"), "member" ], [ human_enum_label("organization_membership", "role", "organiser"), "organiser" ]], ff.object.role || ""),
              {}, class: "select select-sm" %>
      </div>
    <% end %>
  </fieldset>

  <fieldset class="fieldset">
    <legend class="fieldset-legend"><%= t(".password") %></legend>
    <%= f.password_field :password, autocomplete: "new-password", placeholder: user.persisted? ? t(".keep_password") : "", class: "input w-full" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: t(".confirm_password"), class: "input w-full mt-2" unless user.persisted? %>
    <% if user.errors[:password].any? %>
      <p class="label text-error"><%= user.errors[:password].to_sentence %></p>
    <% end %>
    <% if user.persisted? && !user.confirmed? %>
      <p class="label"><%= t(".awaiting_confirmation") %></p>
    <% end %>
  </fieldset>

  <div class="flex gap-2">
    <%= f.submit user.new_record? ? t(".create") : t(".update"), class: "btn btn-primary" %>
    <%= link_to t(".cancel"), users_path, class: "btn btn-ghost" %>
  </div>
<% end %>

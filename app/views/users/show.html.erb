<% content_for :page_title, @user.email %>

<nav aria-label="breadcrumbs" class="breadcrumbs mb-2">
  <% if policy(User).index? %>
    <ul><li><%= link_to t(".breadcrumb_root"), users_path %></li><li><%= @user.email %></li></ul>
  <% end %>
</nav>

<div class="card bg-base-100 shadow mb-6">
  <div class="card-body flex-row flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="card-title"><%= @user.email %></h1>
      <p class="text-sm opacity-70">
        <span class="badge capitalize mr-2 <%= role_badge_class(@user.role) %>"><%= human_enum_label("user", "role", @user.role) %></span>
        <% if @user.organizations.any? %>
          <%= @user.organizations.map(&:name).join(", ") %>
        <% else %>
          <%= t(".no_organization") %>
        <% end %>
      </p>
    </div>
    <div>
      <% if policy(@user).update? && @user != current_user %>
        <%= link_to t(".edit"), edit_user_path(@user), class: "btn btn-outline btn-sm" %>
      <% end %>
    </div>
  </div>
</div>

<div class="card bg-base-100 shadow mb-6">
  <div class="card-body">
    <h2 class="card-title"><%= t(".training_title") %></h2>
    <p class="text-sm opacity-60"><%= t(".training_hint", goal: ApplicationHelper::USER_TRAINING_HOURS_GOAL) %></p>
    <% training_percent = training_hours_percent(@training_hours) %>
    <% training_hours_label = number_with_precision(@training_hours, precision: 1, strip_insignificant_zeros: true) %>
    <progress class="progress progress-primary w-full" value="<%= training_percent %>" max="100" aria-label="<%= t(".training_value", hours: training_hours_label, goal: ApplicationHelper::USER_TRAINING_HOURS_GOAL) %>"></progress>
    <p class="text-sm opacity-70"><%= t(".training_value", hours: training_hours_label, goal: ApplicationHelper::USER_TRAINING_HOURS_GOAL) %> · <%= training_percent %> %</p>
  </div>
</div>

<% if @progress_tree.any? %>
  <div class="card bg-base-100 shadow mb-6">
    <div class="card-body">
      <h2 class="card-title"><%= t(".progress_title") %></h2>
      <p class="text-sm opacity-60"><%= t(".progress_hint") %></p>
      <div class="space-y-2 mt-2">
        <% @progress_tree.each do |level| %>
          <% covered, total = user_topic_area_progress(level, @progress_coverage_ids) %>
          <% percent = user_progress_percent(covered, total) %>
          <div class="collapse collapse-arrow bg-base-200">
            <input type="checkbox" />
            <div class="collapse-title text-sm font-medium">
              <span class="badge badge-primary badge-outline badge-sm mr-1"><%= human_enum_label("content", "content_type", level.content_type) %></span>
              <%= level.title %>
              <span class="text-xs opacity-60 ml-1"><%= t(".progress_count", covered: covered, total: total) %></span>
              <progress class="progress progress-primary w-full mt-1" value="<%= percent %>" max="100" aria-label="<%= t(".progress_count", covered: covered, total: total) %>"></progress>
            </div>
            <div class="collapse-content">
              <% if level.children.any? %>
                <div class="space-y-2">
                  <% level.children.each do |section| %>
                    <% section_covered, section_total = user_topic_progress(section, @progress_coverage_ids, ancestor_covered: @progress_coverage_ids.include?(level.id)) %>
                    <% section_percent = user_progress_percent(section_covered, section_total) %>
                    <div class="bg-base-100 rounded-box p-2">
                      <span class="badge badge-secondary badge-outline badge-sm mr-1"><%= human_enum_label("content", "content_type", section.content_type) %></span>
                      <%= section.title %>
                      <span class="text-xs opacity-60 ml-1"><%= t(".progress_count", covered: section_covered, total: section_total) %></span>
                      <progress class="progress progress-secondary w-full mt-1" value="<%= section_percent %>" max="100" aria-label="<%= t(".progress_count", covered: section_covered, total: section_total) %>"></progress>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<div class="card bg-base-100 shadow">
  <div class="card-body">
    <h2 class="card-title"><%= t(".attendance_title") %></h2>
    <% attendances = @user.unit_attendances.includes(:unit).order("units.starts_at") %>
    <% if attendances.any? %>
      <table class="table table-sm">
        <thead>
          <tr><th><%= t(".table.unit") %></th><th><%= t(".table.status") %></th></tr>
        </thead>
        <tbody>
          <% attendances.each do |attendance| %>
            <tr>
              <td><%= link_to attendance.unit.name, unit_path(attendance.unit), class: "link link-hover" %></td>
              <td><span class="badge <%= attendance_status_badge_class(attendance.status) %>"><%= human_enum_label("unit_attendance", "status", attendance.status) %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="opacity-60"><%= t(".no_attendance") %></p>
    <% end %>
  </div>
</div>

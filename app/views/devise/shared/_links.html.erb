<div class="mt-6 text-sm space-y-1 text-center">
  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <p><%= link_to t("devise_views.shared.links.sign_up"), new_registration_path(resource_name), class: "link link-primary" %></p>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <p><%= link_to t("devise_views.shared.links.forgot_password"), new_password_path(resource_name), class: "link" %></p>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <p><%= link_to t("devise_views.shared.links.resend_confirmation"), new_confirmation_path(resource_name), class: "link" %></p>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <p><%= link_to t("devise_views.shared.links.resend_unlock"), new_unlock_path(resource_name), class: "link" %></p>
  <% end %>
</div>

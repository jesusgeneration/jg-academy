<h2 class="card-title mb-4"><%= t("devise_views.registrations.new.title") %></h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <fieldset class="fieldset space-y-3">
    <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: t("devise_views.registrations.new.email"), value: resource.email.presence || "@jesusgeneration.de", class: "input w-full", required: true %>
    <p class="label"><%= t("devise_views.registrations.new.email_hint") %></p>
    <%= f.password_field :password, autocomplete: "new-password", placeholder: @minimum_password_length ? t("devise_views.registrations.new.password_with_minimum", count: @minimum_password_length) : t("devise_views.registrations.new.password"), class: "input w-full", required: true %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: t("devise_views.registrations.new.confirm_password"), class: "input w-full", required: true %>
    <div>
      <%= f.label :locale, t("devise_views.registrations.edit.language") %>
      <%= f.select :locale, User::LOCALES.map { |code| [ t("languages.#{code}"), code ] }, {}, class: "select w-full" %>
    </div>
  </fieldset>

  <div class="mt-4">
    <%= f.submit t("devise_views.registrations.new.submit"), class: "btn btn-primary w-full" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>

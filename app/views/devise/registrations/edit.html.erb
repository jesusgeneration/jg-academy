<h2 class="card-title mb-4"><%= t("devise_views.registrations.edit.title") %></h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <fieldset class="fieldset space-y-3">
    <%= f.email_field :email, autocomplete: "email", class: "input w-full", disabled: true %>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <p class="text-sm opacity-60"><%= t("devise_views.registrations.edit.waiting_confirmation", email: resource.unconfirmed_email) %></p>
    <% end %>

    <%= f.password_field :password, autocomplete: "new-password", placeholder: @minimum_password_length ? t("devise_views.registrations.edit.new_password_with_minimum", count: @minimum_password_length) : t("devise_views.registrations.edit.new_password"), class: "input w-full" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: t("devise_views.registrations.edit.confirm_new_password"), class: "input w-full" %>
    <%= f.password_field :current_password, autocomplete: "current-password", placeholder: t("devise_views.registrations.edit.current_password_required"), class: "input w-full", required: true %>
    <div>
      <%= f.label :locale, t("devise_views.registrations.edit.language") %>
      <%= f.select :locale, User::LOCALES.map { |code| [ t("languages.#{code}"), code ] }, {}, class: "select w-full" %>
    </div>
  </fieldset>

  <div class="mt-4">
    <%= f.submit t("devise_views.registrations.edit.submit"), class: "btn btn-primary w-full" %>
  </div>
<% end %>

<div class="mt-4">
  <%= link_to t("devise_views.registrations.edit.back"), :back, class: "btn btn-ghost btn-sm w-full" %>
</div>

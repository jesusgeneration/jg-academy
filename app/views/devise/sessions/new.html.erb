<h2 class="card-title mb-4"><%= t("devise_views.sessions.new.title") %></h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <fieldset class="fieldset space-y-3">
    <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: t("devise_views.sessions.new.email"), class: "input w-full", required: true %>
    <%= f.password_field :password, autocomplete: "current-password", placeholder: t("devise_views.sessions.new.password"), class: "input w-full", required: true %>
  </fieldset>

  <% if devise_mapping.rememberable? %>
    <label class="label cursor-pointer justify-start gap-2 mt-2">
      <%= f.check_box :remember_me, class: "checkbox checkbox-sm" %>
      <span><%= t("devise_views.sessions.new.remember_me") %></span>
    </label>
  <% end %>

  <div class="mt-4">
    <%= f.submit t("devise_views.sessions.new.submit"), class: "btn btn-primary w-full" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
